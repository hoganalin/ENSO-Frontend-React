# ============================================================
# ENSO-Frontend-React  /  環境變數範本（Vite）
# ============================================================
# 使用方式：
#   cp .env.example .env.local
#   然後依照下方說明填入實際值。
# .env.local 永遠不會進 git（已加在 .gitignore）。
# ------------------------------------------------------------

# ---- 1. EC API（電商前台）----
# 六角學院 EC API base URL 與個人路徑，demo 預設用 rogan
VITE_API_BASE=https://ec-course-api.hexschool.io/v2
VITE_API_PATH=rogan


# ---- 2. AI Agent Provider ----
# 決定 ShoppingAgent 要用哪個 adapter：
#   mock    離線 mock（預設，永遠能跑，不需 API key）
#   direct  client 端直打 Anthropic，key 會被 bundle 到前端（⚠️ 只用於 local dev）
#
# 注意：純 React 版本沒有 server provider（Next 版才有 /api/agent route handler）。
# 沒設 → fallback 到 mock
VITE_AGENT_PROVIDER=mock


# ---- 3. Anthropic API Key ----
#
# 給 direct mode 使用 ⚠️ 只限本機開發
#   有 VITE_ 前綴 → 會被 bundle 到 client bundle，任何人都看得到。
#   只有在 VITE_AGENT_PROVIDER=direct 時才會被用到。
# VITE_ANTHROPIC_API_KEY=sk-ant-...
