# 本機 Edge Functions 金鑰範本。複製成同目錄的 .env 後填入「sandbox」值。
#   cp supabase/functions/.env.example supabase/functions/.env
# .env 已被 .gitignore 忽略,不會進版控。⚠️ 一律用 TapPay sandbox,切勿填正式金鑰。
#
# TapPay(信用卡付款需要;前端 getPrime 用 .env.local 的 App ID/Key,這裡是後端扣款金鑰)
TAPPAY_ENV=sandbox
TAPPAY_PARTNER_KEY=請填_sandbox_partner_key
TAPPAY_MERCHANT_ID=請填_sandbox_merchant_id
# LINE Pay 選填;不填則沿用上面的 MERCHANT_ID
# TAPPAY_MERCHANT_ID_LINEPAY=

# 導回網址(E2E 本機 vite 跑在 5199)
SITE_URL=http://localhost:5199
ALLOWED_ORIGINS=http://localhost:5199,http://localhost:5173
